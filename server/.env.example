PORT=4000
CLIENT_URL=http://localhost:3000
# Where published sites reach this API (the api subdomain in DEPLOY.md), for counting their visits
# (each site's Analytics screen). Unset: http://localhost:<PORT>, which only works on this machine.
# To try it locally, run `npm run tunnel` beside `npm run dev`: it opens a Cloudflare tunnel (needs
# cloudflared: winget install Cloudflare.cloudflared) and writes its https address here. The address
# changes each run, so then press "Update the counter" on the Analytics screen and publish.
# PUBLIC_API_URL=https://api.mydomain.com

# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# MongoDB: users, their encrypted Anthropic keys, and which repos are site copies.
# With auth enabled: mongodb://USER:PASSWORD@127.0.0.1:27017/twinstack?authSource=twinstack
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=twinstack

# Encrypts users' Anthropic keys in MongoDB. 64 hex characters, generate like JWT_SECRET.
# Keep it safe and never change it: stored keys can't be decrypted without it.
DATA_ENCRYPTION_KEY=

# The site repo users duplicate. Only it can be copied, it can't be managed
# directly, and only copies of it appear in the repository list.
SITE_TEMPLATE_REPO=DemoProjectDjango/twinstack-site

# Access to create sites: accounts ask on the dashboard, admins approve them on /admin/access.
# A read-only token for the (private) template, so approved accounts needn't be collaborators:
# GitHub → Settings → Developer settings → Fine-grained tokens, "Only select repositories" →
# the template, Repository permissions → Contents: Read-only. Unset, each account's own GitHub
# token must be able to read the template.
TEMPLATE_GITHUB_TOKEN=
# Sign-in emails of the accounts that review requests (comma-separated). Always approved.
# Register these accounts before going live: there's no email verification yet.
ADMIN_EMAILS=

# Emails (new requests to the admins, answers to the people who asked), sent through
# https://resend.com. Unset, emails are printed to the server log instead. EMAIL_FROM must use a
# domain verified in Resend; without one, Resend only delivers to your own Resend sign-up address.
RESEND_API_KEY=
EMAIL_FROM=Twinstack <noreply@example.com>

# Secure cookies (HTTPS only) default to on when NODE_ENV=production.
# COOKIE_SECURE=false only for testing over plain http.
# COOKIE_SECURE=

# Where site working copies are cloned (default: <os tmpdir>/twinstack-workspaces).
# Uncommitted work lives here, so use persistent disk in production.
WORKSPACES_DIR=

# The app's Anthropic key. Claude runs on it for every account that hasn't added its own key, and
# each request is paid for with the account's credits (every account starts with 10000 credits,
# worth $1 of Claude use). It never reaches the site's scripts. Unset, only accounts with their own
# key can use Claude.
# PLATFORM_ANTHROPIC_KEY=

# The cheaper "fast" model (optional). Routine page work on credits (a new page or an edit, without
# photos, on a site that already has a design), header and footer work, search text and site details
# are written by it first, and by the account's Claude model if that result fails the site's checks.
# Charged in credits like Claude. An admin picks the model on /admin/models (DeepSeek or ChatGPT/OpenAI);
# a model only works when its provider's key is set here.
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# The default until an admin picks one: any deepseek-* or OpenAI (gpt-*) model, or "off" to keep
# everything on Claude. Unset: deepseek-flash with a DeepSeek key, else gpt-6-luna with an OpenAI key.
# FAST_PAGE_MODEL=deepseek-flash

# Pictures "Ask Claude" makes (photos and illustrations for pages) come from OpenAI's image models,
# on OPENAI_API_KEY above, charged in credits from each image's token usage. Without that key Claude
# can still draw SVG images. This is the default until an admin picks one on /admin/models, and each
# site can choose its own on its AI models screen. Any gpt-image-* model; unset: gpt-image-2.
IMAGE_MODEL=gpt-image-2

# Buying credits adds them straight away without any payment (a demo until payments are added).
# Set to false to turn buying credits off.
# CREDITS_DEMO_PURCHASES=true

# "Ask Claude" (the site editor's assistant) calls Claude from this server with the account's own
# Anthropic key, or the app's key above. Each account picks its Claude model in Settings (server/src/claude-models.js), for
# the assistant and the site's Claude commands. Optional: the default for accounts that haven't
# picked one, which must be in that list (default claude-opus-5-5).
# ASSISTANT_MODEL=
