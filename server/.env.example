PORT=4000
CLIENT_URL=http://localhost:3000

# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# MongoDB: users, their encrypted Anthropic keys, and which repos are site copies.
# With auth enabled: mongodb://USER:PASSWORD@127.0.0.1:27017/twinstack?authSource=twinstack
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=twinstack

# Encrypts users' Anthropic keys in MongoDB. 64 hex characters, generate like JWT_SECRET.
# Keep it safe and never change it: stored keys can't be decrypted without it.
DATA_ENCRYPTION_KEY=d6b18b3d0dcb851016b87c5c46dd4b84b333798f57129feed610c987017ef78c 

# The site repo users duplicate. Only it can be copied, it can't be managed
# directly, and only copies of it appear in the repository list.
SITE_TEMPLATE_REPO=DemoProjectDjango/twinstack-site

# Secure cookies (HTTPS only) default to on when NODE_ENV=production.
# COOKIE_SECURE=false only for testing over plain http.
# COOKIE_SECURE=

# Where site working copies are cloned (default: <os tmpdir>/twinstack-workspaces).
# Uncommitted work lives here, so use persistent disk in production.
WORKSPACES_DIR=

# The app's Anthropic key. Claude runs on it for every account that hasn't added its own key, and
# each request is paid for with the account's credits (every account starts with 10000 credits,
# worth $1 of Claude use). It never reaches the site's scripts. Unset, only accounts with their own
# key can use Claude.
# PLATFORM_ANTHROPIC_KEY=

# Buying credits adds them straight away without any payment (a demo until payments are added).
# Set to false to turn buying credits off.
# CREDITS_DEMO_PURCHASES=true

# "Ask Claude" (the site editor's assistant) calls Claude from this server with the account's own
# Anthropic key, or the app's key above. Each account picks its Claude model in Settings (server/src/claude-models.js), for
# the assistant and the site's Claude commands. Optional: the default for accounts that haven't
# picked one, which must be in that list (default claude-opus-5-5).
# ASSISTANT_MODEL=
